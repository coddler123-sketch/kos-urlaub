<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_dark_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_background_description"
        android:scaleType="centerCrop"
        android:src="@drawable/kos_rot_11" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_scrim" />

    <LinearLayout
        android:id="@+id/widget_countdown_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/widget_glass_place"
            android:textAllCaps="true"
            android:textColor="@color/widget_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="125"
            android:textColor="@color/widget_on_photo"
            android:textSize="58sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_days_unit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Tage bis zum Abflug"
                android:textColor="@color/widget_on_photo"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="13. September"
                android:textColor="@color/widget_on_photo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plane"
                android:tint="@color/widget_on_photo" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_message_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_arrival_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="27sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/widget_arrival_message"
            android:textColor="@color/widget_on_photo"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_vacation_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/widget_vacation_line2"
            android:textColor="@color/widget_on_photo"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Wetterblase oben rechts -->
    <LinearLayout
        android:id="@+id/widget_weather_pill"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:background="@drawable/widget_bubble_background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/widget_weather_description"
            android:src="@drawable/ic_sun"
            android:tint="@color/widget_gold" />

        <TextView
            android:id="@+id/widget_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_weather_temp"
            android:textColor="@color/widget_on_photo"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
