<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper_background"
    android:clipToOutline="true">

    <!-- Tagesbild vollflaechig -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_background_description"
        android:scaleType="centerCrop"
        android:src="@drawable/kos_rot_11" />

    <!-- Scrim: oben leicht, unten kraeftig fuer Lesbarkeit -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_photo_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <!-- Kopfzeile: KOS + Herz links, Wetter-Glaspille rechts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_large_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:text="@string/widget_large_title"
                android:textColor="@color/widget_on_photo"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_heart"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="8dp"
                android:contentDescription="@string/widget_favorite_description"
                android:src="@drawable/ic_heart_outline"
                android:tint="@color/widget_on_photo" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/widget_weather_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_weather_pill_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="5dp"
                    android:contentDescription="@string/widget_weather_description"
                    android:src="@drawable/ic_sun"
                    android:tint="@color/widget_on_photo" />

                <TextView
                    android:id="@+id/widget_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_weather_temp"
                    android:textColor="@color/widget_on_photo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_refresh_icon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="6dp"
                    android:alpha="0.7"
                    android:contentDescription="@string/widget_refresh_description"
                    android:src="@drawable/ic_refresh_subtle"
                    android:tint="@color/widget_on_photo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Platz: Foto bleibt sichtbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Countdown: grosse Tage-Zahl, Std./Min. klein rechts -->
        <LinearLayout
            android:id="@+id/widget_countdown_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="23"
                android:textColor="@color/widget_on_photo"
                android:textSize="52sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="@string/widget_days_label"
                    android:textColor="@color/widget_on_photo"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:text="@string/widget_subtitle"
                    android:textColor="@color/widget_on_photo_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="14"
                    android:textColor="@color/widget_on_photo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="8dp"
                    android:includeFontPadding="false"
                    android:text="@string/widget_hours_label"
                    android:textColor="@color/widget_on_photo_soft"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_minutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="37"
                    android:textColor="@color/widget_on_photo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:includeFontPadding="false"
                    android:text="@string/widget_minutes_label"
                    android:textColor="@color/widget_on_photo_soft"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fortschrittsbalken -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <!-- Abflugtag / Urlaub: ersetzt den Countdown -->
        <TextView
            android:id="@+id/widget_arrival_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="27sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_arrival_message"
            android:textColor="@color/widget_on_photo"
            android:textSize="27sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_vacation_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_vacation_line2"
            android:textColor="@color/widget_on_photo_soft"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Spruch des Tages -->
        <LinearLayout
            android:id="@+id/widget_phrase_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginRight="7dp"
                android:contentDescription="@string/widget_phrase_description"
                android:src="@drawable/ic_sparkle"
                android:tint="@color/widget_on_photo" />

            <TextView
                android:id="@+id/widget_phrase_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_phrase"
                android:textColor="@color/widget_on_photo"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
