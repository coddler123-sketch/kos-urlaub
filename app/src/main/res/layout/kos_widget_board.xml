<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Foto mit Klappzahlen -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_background_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_background_description"
                android:scaleType="centerCrop"
                android:src="@drawable/kos_rot_11" />

            <LinearLayout
                android:id="@+id/widget_digits_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="54dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/widget_flip_tile">

                    <TextView
                        android:id="@+id/widget_digit_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/widget_board_digit"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center_vertical"
                        android:background="#99000000" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="54dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/widget_flip_tile">

                    <TextView
                        android:id="@+id/widget_digit_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="2"
                        android:textColor="@color/widget_board_digit"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center_vertical"
                        android:background="#99000000" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="54dp"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/widget_flip_tile">

                    <TextView
                        android:id="@+id/widget_digit_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="3"
                        android:textColor="@color/widget_board_digit"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center_vertical"
                        android:background="#99000000" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_days_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_board_label_background"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.14"
                    android:paddingLeft="6dp"
                    android:paddingTop="3dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_days_label"
                    android:textColor="@color/widget_ink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Wetter als gestempelter Kreis -->
            <LinearLayout
                android:id="@+id/widget_weather_pill"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|right"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/widget_board_weather_background"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/widget_weather_description"
                    android:src="@drawable/ic_sun"
                    android:tint="@color/widget_board_red" />

                <TextView
                    android:id="@+id/widget_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="@string/widget_weather_temp"
                    android:textColor="@color/widget_board_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Perforation zwischen Foto und Papier -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="-3dp"
                android:background="@drawable/widget_board_perforation" />
        </FrameLayout>

        <!-- Papierteil -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/widget_countdown_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_route"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="HAMBURG → KOS"
                        android:textColor="@color/widget_ink"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/widget_hours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:includeFontPadding="false"
                                android:text="14"
                                android:textColor="@color/widget_ink"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.12"
                                android:text="@string/widget_hours_label"
                                android:textColor="@color/widget_ink_soft"
                                android:textSize="8sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/widget_minutes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:includeFontPadding="false"
                                android:text="37"
                                android:textColor="@color/widget_ink"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.12"
                                android:text="@string/widget_minutes_label"
                                android:textColor="@color/widget_ink_soft"
                                android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_flight_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="@string/widget_subtitle"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_ink_soft"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_from_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.12"
                        android:text="HAM"
                        android:textColor="@color/widget_ink"
                        android:textSize="9sp" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="13dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp"
                        android:layout_weight="1"
                        android:clipChildren="false">

                        <ProgressBar
                            android:id="@+id/widget_progress_bar"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_gravity="center_vertical"
                            android:max="1000"
                            android:progressDrawable="@drawable/widget_board_progress_drawable" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_0"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_1"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_2"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_3"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_4"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_5"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_6"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_7"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_8"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_9"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_10"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_11"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_12"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_13"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_14"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_15"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_16"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_17"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_18"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_19"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clipChildren="false">

                                <ImageView
                                    android:id="@+id/widget_plane_20"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:rotation="90"
                                    android:src="@drawable/ic_plane"
                                    android:tint="@color/widget_board_red"
                                    android:visibility="invisible" />
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/widget_to_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.12"
                        android:text="KGS"
                        android:textColor="@color/widget_ink"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_phrase_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_phrase_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_phrase"
                        android:textColor="@color/widget_ink"
                        android:textSize="13sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_message_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_arrival_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="26sp"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/widget_arrival_message"
                    android:textColor="@color/widget_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_vacation_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
